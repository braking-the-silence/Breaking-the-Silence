<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="color-scheme" content="dark">
<meta name="description" content="Reporta cobros indebidos y abusos policiales en todo el Perú de forma rápida, segura y confidencial.">
<style>*,*::before,*::after{box-sizing:border-box}body{margin:0}img{max-width:100%}[hidden]{display:none!important}</style>
<title>Breaking the Silence</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap">
<script src="https://cdn.tailwindcss.com"></script>
<script>

  tailwind.config = {
    theme: { extend: {
      colors: { brand: {
        blue:'#2563EB','blue-bright':'#60A5FA', purple:'#7C3AED','purple-bright':'#A78BFA',
        neon:'#10B981','neon-bright':'#34D399', glow:'#00FF87', dark:'#0B0F19', ink:'#0F172A', slate:'#1E293B' } },
      fontFamily: { sans:['Inter','Segoe UI','system-ui','sans-serif'] },
      animation: { 'pulse-glow':'pulseGlow 2.2s infinite' },
      keyframes: { pulseGlow:{
        '0%,100%':{ boxShadow:'0 0 18px rgba(0,255,135,.45),0 0 40px rgba(124,58,237,.25)' },
        '50%':{ boxShadow:'0 0 34px rgba(0,255,135,.85),0 0 64px rgba(37,99,235,.5)' } } }
    } }
  }
</script>
<style>
  :root{color-scheme:dark}
  html{scroll-behavior:smooth}
  body{background:#0B0F19;color:#E2E8F0;font-family:'Inter','Segoe UI',system-ui,sans-serif;overflow-x:hidden}
  body::before{content:"";position:fixed;inset:0;z-index:-1;pointer-events:none;
    background:radial-gradient(60vw 45vh at 0% 0%,rgba(37,99,235,.22),transparent 70%),
               radial-gradient(55vw 45vh at 100% 20%,rgba(124,58,237,.22),transparent 70%),
               radial-gradient(50vw 40vh at 40% 100%,rgba(16,185,129,.1),transparent 70%),#0B0F19}
  :focus-visible{outline:2px solid #00FF87;outline-offset:3px;border-radius:10px}
  .glass-panel{background:rgba(17,24,39,.72);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border:1px solid rgba(124,58,237,.28);
    box-shadow:0 24px 60px -24px rgba(0,0,0,.7),inset 0 1px 0 rgba(255,255,255,.06)}
  .glass-card{background:rgba(15,23,42,.6);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border:1px solid rgba(255,255,255,.08);transition:.25s}
  .glass-card:hover{border-color:rgba(52,211,153,.45);box-shadow:0 0 28px rgba(16,185,129,.15)}
  .gradient-text{background:linear-gradient(135deg,#60A5FA 0%,#A78BFA 50%,#34D399 100%);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;filter:drop-shadow(0 0 24px rgba(0,255,135,.25))}
  .btn-neon{background:linear-gradient(135deg,#00FF87,#10B981);color:#03140C;transition:transform .2s,box-shadow .2s}
  .btn-neon:hover{transform:translateY(-2px) scale(1.02)}
  .btn-neon:active{transform:scale(.98)}
  .btn-neon[disabled]{filter:saturate(.6);cursor:progress}
  .sect{background:rgba(15,23,42,.55);border:1px solid rgba(148,163,184,.14);border-radius:1rem;padding:1.1rem}
  .inp{width:100%;background:#060A14;border:1px solid #334155;border-radius:.85rem;padding:.8rem .95rem;font-size:16px;color:#F1F5F9;transition:.2s;color-scheme:dark}
  .inp::placeholder{color:#64748B}
  .inp:hover{border-color:rgba(124,58,237,.7)}
  .inp:focus{outline:none;border-color:#00FF87;box-shadow:0 0 0 3px rgba(0,255,135,.16),0 0 18px rgba(0,255,135,.15)}
  .bad .inp{border-color:#F43F5E;box-shadow:0 0 0 3px rgba(244,63,94,.14)}
  .ok .inp{border-color:rgba(0,255,135,.5)}
  .err{display:none;font-size:12.5px;color:#FB7185;margin-top:6px}
  .bad .err{display:block}
  .lbl{display:block;font-size:12px;color:#94A3B8;margin-bottom:6px}
  .veh input{position:absolute;opacity:0}
  .veh .box{display:flex;flex-direction:column;align-items:center;gap:6px;padding:14px 6px;border-radius:.9rem;background:#060A14;border:1px solid #1E293B;color:#94A3B8;font-size:12.5px;font-weight:600;transition:.2s;cursor:pointer;text-align:center}
  .veh .box:hover{border-color:#7C3AED;color:#fff;box-shadow:0 0 18px rgba(124,58,237,.45);transform:translateY(-2px)}
  .veh input:checked + .box{border-color:#00FF87;color:#00FF87;background:linear-gradient(160deg,rgba(37,99,235,.28),rgba(124,58,237,.28));box-shadow:0 0 22px rgba(0,255,135,.3)}
  .veh input:focus-visible + .box{outline:2px solid #00FF87;outline-offset:3px}
  .bad .veh .box{border-color:rgba(244,63,94,.6)}
  .pill{font-size:12px;padding:6px 12px;border-radius:.6rem;background:#060A14;border:1px solid #1E293B;color:#CBD5E1;transition:.2s}
  .pill:hover{border-color:#00FF87;color:#fff;box-shadow:0 0 14px rgba(0,255,135,.3)}
  .drop{border:2px dashed rgba(124,58,237,.55);border-radius:1rem;padding:1.4rem 1rem;text-align:center;cursor:pointer;background:rgba(6,10,20,.5);transition:.2s;display:block}
  .drop:hover,.drop.over{border-color:#00FF87;background:rgba(16,185,129,.08);box-shadow:0 0 26px rgba(0,255,135,.18)}
  .sw{width:48px;height:27px;border-radius:999px;background:#334155;position:relative;transition:.25s;flex:none;display:block}
  .sw::after{content:"";position:absolute;top:3px;left:3px;width:21px;height:21px;border-radius:50%;background:#fff;transition:.25s}
  #anon:checked + .sw{background:#10B981;box-shadow:0 0 16px #00FF87}
  #anon:checked + .sw::after{transform:translateX(21px)}
  #anon:focus-visible + .sw{outline:2px solid #00FF87;outline-offset:3px}
  .meter i{display:block;height:100%;width:0;background:linear-gradient(90deg,#2563EB,#7C3AED,#00FF87);box-shadow:0 0 10px #00FF87;transition:width .35s}
  .seg button{padding:.5rem 1rem;border-radius:.65rem;font-size:13px;font-weight:600;color:#94A3B8;transition:.2s}
  .seg button:hover{color:#fff}
  .seg button[aria-pressed=true]{color:#fff;background:linear-gradient(135deg,#2563EB,#7C3AED);box-shadow:0 0 16px rgba(124,58,237,.7)}
  .mapbox canvas{width:100%;height:100%;display:block;touch-action:pan-y}
  .tip{position:absolute;pointer-events:none;padding:8px 12px;border-radius:12px;font-size:13px;white-space:nowrap;z-index:3;transform:translate(-50%,-130%);
    background:rgba(15,23,42,.94);border:1px solid rgba(124,58,237,.5);box-shadow:0 0 20px rgba(124,58,237,.5);opacity:0;transition:opacity .15s}
  .tip.on{opacity:1}
  details.faq{transition:.25s}
  details.faq[open]{border-color:rgba(37,99,235,.65);box-shadow:0 0 30px rgba(37,99,235,.25)}
  details.faq summary{list-style:none;cursor:pointer}
  details.faq summary::-webkit-details-marker{display:none}
  details.faq .pm{transition:transform .25s}
  details.faq[open] .pm{transform:rotate(45deg);color:#00FF87}
  .dot{width:8px;height:8px;border-radius:50%;background:#00FF87;animation:dotp 1.8s infinite;flex:none}
  @keyframes dotp{0%{box-shadow:0 0 0 0 rgba(0,255,135,.7)}70%{box-shadow:0 0 0 9px rgba(0,255,135,0)}100%{box-shadow:0 0 0 0 rgba(0,255,135,0)}}
  .spin{width:20px;height:20px;border-radius:50%;border:3px solid rgba(3,20,12,.25);border-top-color:#03140C;animation:sp .7s linear infinite}
  @keyframes sp{to{transform:rotate(360deg)}}
  .toast{position:fixed;left:50%;bottom:calc(20px + env(safe-area-inset-bottom,0px));z-index:100;transform:translate(-50%,160%);display:flex;align-items:center;gap:12px;
    padding:14px 18px;border-radius:16px;max-width:calc(100vw - 32px);font-size:14px;font-weight:600;line-height:1.35;color:#F1F5F9;background:rgba(15,23,42,.96);
    border:1px solid rgba(0,255,135,.6);box-shadow:0 0 30px rgba(0,255,135,.3),0 20px 40px -10px rgba(0,0,0,.7);transition:transform .45s cubic-bezier(.2,1.2,.3,1)}
  .toast.on{transform:translate(-50%,0)}
  .toast.bad{border-color:#F43F5E;box-shadow:0 0 30px rgba(244,63,94,.3),0 20px 40px -10px rgba(0,0,0,.7)}
  .toast .ic{flex:none;width:26px;height:26px;border-radius:50%;display:grid;place-items:center;background:#10B981;color:#03140C;font-weight:900}
  .toast.bad .ic{background:#F43F5E;color:#fff}
  .check circle{stroke:#00FF87;stroke-width:3;fill:rgba(0,255,135,.08);stroke-dasharray:264;stroke-dashoffset:264;animation:dr .7s .1s forwards}
  .check path{stroke:#00FF87;stroke-width:5;fill:none;stroke-linecap:round;stroke-linejoin:round;stroke-dasharray:60;stroke-dashoffset:60;animation:dr .5s .7s forwards}
  @keyframes dr{to{stroke-dashoffset:0}}
  ::-webkit-scrollbar{width:8px;height:8px}::-webkit-scrollbar-track{background:#0B0F19}::-webkit-scrollbar-thumb{background:#1F2937;border-radius:4px}::-webkit-scrollbar-thumb:hover{background:#7C3AED}
  @media (prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important;scroll-behavior:auto!important}}
</style>

</head>
<body>

<header class="sticky z-50 glass-panel border-x-0 border-t-0 px-4 lg:px-8 py-3" style="top:env(safe-area-inset-top,0px)">
  <div class="max-w-7xl mx-auto flex items-center justify-between gap-3 flex-wrap">
    <div class="flex items-center gap-3 min-w-0">
      <div class="w-10 h-10 shrink-0 rounded-xl bg-gradient-to-tr from-brand-blue via-brand-purple to-brand-neon p-0.5 shadow-lg shadow-purple-500/30">
        <div class="w-full h-full bg-slate-950 rounded-[10px] flex items-center justify-center text-brand-glow"><i data-i="shield-alert" class="w-5 h-5"></i></div>
      </div>
      <div class="min-w-0">
        <p class="font-black text-lg sm:text-xl tracking-tight text-white leading-tight truncate">Breaking the Silence</p>
        <p class="text-xs text-slate-400 font-medium truncate">Powered by <span class="text-slate-200 font-semibold">Vanguardia Ciudadana</span></p>
      </div>
    </div>

    <div class="flex items-center gap-2 sm:gap-3 ml-auto">
      <span class="hidden lg:inline-flex items-center gap-2 text-xs font-semibold text-brand-glow bg-brand-neon/10 border border-brand-glow/40 rounded-full px-3 py-1.5 shadow-[0_0_16px_rgba(0,255,135,.18)]" role="status"><i class="dot"></i>Conexión Cifrada &amp; Anónima Activa</span>
      <a href="#stats" class="hidden md:flex items-center gap-1.5 text-xs font-semibold text-slate-300 hover:text-brand-glow px-3 py-2 rounded-lg hover:bg-slate-800/60 transition"><i data-i="map-pin" class="w-4 h-4"></i>Mapa y cifras</a>
      <a href="#faq" class="hidden md:flex items-center gap-1.5 text-xs font-semibold text-slate-300 hover:text-brand-glow px-3 py-2 rounded-lg hover:bg-slate-800/60 transition"><i data-i="help" class="w-4 h-4"></i>Seguridad</a>
      <button id="exitBtn" type="button" title="Salir a Google (o pulsa Esc dos veces)" class="flex items-center gap-1.5 text-xs font-bold text-rose-300 bg-rose-950/40 hover:bg-rose-900/60 border border-rose-800/50 px-3 py-2 rounded-xl transition active:scale-95 hover:shadow-[0_0_16px_rgba(244,63,94,.4)]">
        <i data-i="power" class="w-4 h-4"></i><span>Salida de emergencia</span>
      </button>
    </div>
    <span class="lg:hidden w-full inline-flex items-center justify-center gap-2 text-xs font-semibold text-brand-glow bg-brand-neon/10 border border-brand-glow/40 rounded-full px-3 py-1.5" role="status"><i class="dot"></i>Conexión Cifrada &amp; Anónima Activa</span>
  </div>
</header>

<main>

<section class="relative overflow-hidden px-4 sm:px-6 lg:px-8 pt-14 pb-14 lg:pt-24 lg:pb-20 border-b border-slate-800/70">
  <div class="relative z-10 max-w-4xl mx-auto text-center space-y-6">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-slate-900/80 border border-brand-neon/30 text-brand-neon-bright text-xs font-semibold">
      <i data-i="lock" class="w-3.5 h-3.5"></i><span>Sin cuentas · Sin nombre · Sin teléfono</span>
    </div>
    <h1 class="text-[2.6rem] leading-[1.02] sm:text-6xl lg:text-7xl font-black tracking-tight"><span class="gradient-text">Breaking the Silence</span></h1>
    <p class="text-lg sm:text-xl text-slate-300 max-w-2xl mx-auto leading-relaxed">
      Reporta cobros indebidos y abusos policiales de forma <span class="text-brand-neon-bright font-semibold">rápida</span>, <span class="text-brand-blue-bright font-semibold">segura</span> y <span class="text-brand-purple-bright font-semibold">100% confidencial</span>.
    </p>
    <div class="inline-flex items-center gap-2 text-xs text-slate-400 bg-slate-900/60 px-4 py-2 rounded-xl border border-slate-800">
      <i data-i="car" class="w-4 h-4 text-brand-blue-bright"></i><span>Hecho para llenarse en menos de 1 minuto desde tu vehículo (detente antes de escribir).</span>
    </div>
    <div class="pt-3 flex justify-center">
      <a id="ctaMain" href="#reporte" class="btn-neon animate-pulse-glow font-black text-lg px-8 py-4 rounded-2xl flex items-center gap-3 group">
        <span aria-hidden="true">🚨</span> Registrar un reporte aquí <i data-i="chevron-down" class="w-5 h-5 group-hover:translate-y-1 transition-transform"></i>
      </a>
    </div>
    <div class="flex flex-wrap justify-center gap-x-8 gap-y-3 pt-4 text-sm">
      <div><b id="heroTotal" class="text-2xl font-black text-white tabular-nums">0</b><span class="block text-xs text-slate-400">denuncias registradas</span></div>
      <div><b id="heroToday" class="text-2xl font-black text-brand-glow tabular-nums">0</b><span class="block text-xs text-slate-400">en las últimas 24 h</span></div>
      <div><b id="heroMoney" class="text-2xl font-black text-brand-purple-bright tabular-nums">S/ 0</b><span class="block text-xs text-slate-400">exigidos en total</span></div>
    </div>
  </div>
</section>

<section id="reporte" class="px-4 sm:px-6 lg:px-8 py-14 lg:py-20 max-w-3xl mx-auto scroll-mt-24">
  <div class="glass-panel rounded-3xl p-5 sm:p-9 relative overflow-hidden">
    <div class="absolute top-0 inset-x-0 h-1.5 bg-gradient-to-r from-brand-blue via-brand-purple to-brand-glow"></div>

    <div class="flex items-start justify-between gap-3 mb-5 pb-4 border-b border-slate-800">
      <div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white flex items-center gap-2.5"><i data-i="shield-check" class="w-7 h-7 text-brand-glow shrink-0"></i>Formulario de reporte</h2>
        <p class="text-xs sm:text-sm text-slate-400 mt-1">Llena lo que hayas podido ver. Lo esencial: dónde, con qué te intervinieron y qué te pidieron.</p>
      </div>
      <span id="anonBadge" class="shrink-0 px-3 py-1.5 rounded-full bg-brand-neon/10 border border-brand-neon/40 text-brand-neon-bright text-xs font-bold inline-flex items-center gap-1.5"><i data-i="shield-check" class="w-3.5 h-3.5"></i><span>Anónimo</span></span>
    </div>
    <div class="meter h-1 rounded bg-slate-800 overflow-hidden mb-6" aria-hidden="true"><i id="meter"></i></div>

    <form id="rf" novalidate autocomplete="off" class="space-y-5">
      <!-- 1. Ubicación -->
      <div class="sect space-y-3">
        <p class="text-sm font-bold text-slate-100 flex items-center justify-between"><span class="flex items-center gap-2"><i data-i="map-pin" class="w-4 h-4 text-brand-blue-bright"></i>1. Ubicación del hecho</span><span class="text-xs text-brand-glow font-semibold">obligatorio</span></p>
        <div class="grid sm:grid-cols-2 gap-3">
          <div id="f-district" class="sm:col-span-2"><div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div><label class="lbl" for="dep">Departamento</label><select id="dep" class="inp"></select></div>
            <div><label class="lbl" for="prov">Provincia</label><select id="prov" class="inp" disabled></select></div>
            <div><label class="lbl" for="district">Distrito</label><select id="district" class="inp" disabled></select></div></div>
            <p class="err">Elige departamento, provincia y distrito donde ocurrió.</p></div>
          <div id="f-place" class="sm:col-span-2"><label class="lbl" for="place">Avenida principal, intersección o referencia</label>
            <input id="place" class="inp" type="text" maxlength="160" placeholder="Ej.: Av. Javier Prado con Aviación, frente al grifo">
            <p class="err">Indica la avenida o un punto de referencia (mín. 4 letras).</p></div>
        </div>
        <button id="gps" type="button" class="inline-flex items-center gap-2 text-xs font-semibold bg-slate-800/80 hover:bg-slate-700 text-brand-blue-bright border border-brand-blue/40 px-3.5 py-2.5 rounded-xl transition active:scale-95 hover:shadow-[0_0_16px_rgba(37,99,235,.4)] disabled:opacity-60">
          <i data-i="crosshair" class="w-4 h-4"></i><span id="gpsTxt">Usar mi ubicación GPS actual</span></button>
      </div>

      <!-- 2. Fecha y hora -->
      <div class="sect space-y-3">

                <p class="text-sm font-bold text-slate-100 flex items-center justify-between"><span class="flex items-center gap-2"><i data-i="clock" class="w-4 h-4 text-brand-purple-bright"></i>2. Fecha y hora</span><span class="text-xs text-slate-400">ya puesta con la hora actual</span></p>
        <div class="grid grid-cols-2 gap-3">
          <div id="f-date"><label class="lbl" for="rdate">Fecha</label><input id="rdate" type="date" class="inp"></div>
          <div id="f-time"><label class="lbl" for="rtime">Hora aproximada</label><input id="rtime" type="time" class="inp"></div>
        </div>
        <p id="whenErr" class="err" style="display:none">La fecha y hora no pueden ser futuras.</p>
      </div>

      <div class="sect space-y-4">
        <p class="text-sm font-bold text-slate-100 flex items-center justify-between"><span class="flex items-center gap-2"><i data-i="siren" class="w-4 h-4 text-brand-glow"></i>3. Datos de la intervención</span><span class="text-xs text-brand-glow font-semibold">obligatorio</span></p>
        <div id="f-veh">
          <span class="lbl">Tipo de vehículo policial</span>
          <div class="grid grid-cols-3 gap-2 sm:gap-3">
            <label class="veh relative"><input type="radio" name="veh" value="Patrulla"><span class="box"><i data-i="car" class="w-6 h-6"></i>Patrulla 🚔</span></label>
            <label class="veh relative"><input type="radio" name="veh" value="Moto"><span class="box"><i data-i="bike" class="w-6 h-6"></i>Moto 🏍️</span></label>
            <label class="veh relative"><input type="radio" name="veh" value="A pie"><span class="box"><i data-i="user" class="w-6 h-6"></i>Efectivo a pie 👮</span></label>
          </div>
          <p class="err">Elige con qué te intervinieron.</p>
        </div>
        <div><label class="lbl" for="plate">Placa del vehículo o apellido / número de identificación del efectivo <span class="text-slate-500">(opcional, si lograste verlo)</span></label>
          <input id="plate" class="inp" type="text" maxlength="60" placeholder="Ej.: EGA-123 · apellido en el chaleco"></div>
      </div>

      <!-- 4. Monto -->
      <div class="sect space-y-3">
        <p class="text-sm font-bold text-slate-100 flex items-center justify-between"><span class="flex items-center gap-2"><i data-i="banknote" class="w-4 h-4 text-brand-glow"></i>4. Monto o tipo de exigencia</span><span class="text-xs text-brand-glow font-semibold">obligatorio</span></p>
        <div class="flex flex-wrap gap-2" id="presets">
          <button type="button" class="pill" data-v="S/ 20">S/ 20</button><button type="button" class="pill" data-v="S/ 50">S/ 50</button>
          <button type="button" class="pill" data-v="S/ 100">S/ 100</button><button type="button" class="pill" data-v="S/ 200">S/ 200</button>
          <button type="button" class="pill" data-v="Transferencia por aplicativo">Transferencia por app</button><button type="button" class="pill" data-v="Bienes o especie">Bienes / especie</button>
        </div>
        <div id="f-amt"><label class="lbl" for="amt">Monto solicitado en dinero (S/ o $) o tipo de beneficio exigido</label>
          <input id="amt" class="inp" type="text" maxlength="120" placeholder="Ej.: S/ 50 · $20 · pidió que le invite un almuerzo">
          <p class="err">Cuéntanos qué te pidieron: un monto o el tipo de beneficio.</p></div>
      </div>

      <div class="sect space-y-3">
        <p class="text-sm font-bold text-slate-100 flex items-center justify-between"><span class="flex items-center gap-2"><i data-i="paperclip" class="w-4 h-4 text-brand-blue-bright"></i>5. Evidencia</span><span class="text-xs text-slate-400">opcional · foto, video o audio</span></p>
        <label id="drop" class="drop" for="fileIn">
          <span class="mx-auto mb-2 w-10 h-10 rounded-full bg-slate-900 flex items-center justify-center text-brand-purple-bright"><i data-i="upload" class="w-5 h-5"></i></span>
          <span class="block text-sm text-slate-200 font-semibold">Arrastra aquí tus archivos o toca para elegirlos</span>
          <span class="block text-[11px] text-slate-500 mt-1">Fotos, videos cortos o audios · máx. 5 archivos de 25 MB</span>
        </label>
        <input id="fileIn" type="file" accept="image/*,video/*,audio/*" multiple hidden>
        <ul id="files" class="grid gap-2"></ul>
        <p id="fileErr" class="text-xs text-rose-400" hidden></p>
      </div>

      <label for="anon" class="flex items-center justify-between gap-4 p-4 rounded-2xl cursor-pointer bg-gradient-to-r from-brand-purple/20 via-slate-900/60 to-brand-blue/20 border border-brand-neon/40 shadow-[0_0_22px_rgba(0,255,135,.12)]">
        <span class="block">
          <span class="text-sm font-bold text-white flex items-center gap-2"><i data-i="lock" class="w-4 h-4 text-brand-glow shrink-0"></i>Guardar reporte de manera 100% anónima</span>
          <span class="block text-xs text-slate-400 mt-0.5">Tus datos técnicos no serán almacenados.</span>
        </span>
        <span class="relative"><input id="anon" type="checkbox" checked class="absolute opacity-0 inset-0"><span class="sw"></span></span>
      </label>

      <button id="submitBtn" type="submit" class="btn-neon w-full py-4 px-6 rounded-2xl font-black text-lg flex items-center justify-center gap-2.5 shadow-xl shadow-brand-neon/20">
        <span id="sIco"><i data-i="send" class="w-5 h-5"></i></span><span id="sSpin" class="spin" hidden></span><span id="sTxt">Enviar reporte seguro</span>
      </button>
      <p class="text-center text-xs text-slate-500">Solo se guarda distrito, referencia, fecha, tipo de intervención y exigencia. Nunca tu nombre.</p>
    </form>
  </div>
</section>

<section id="stats" class="px-4 sm:px-6 lg:px-8 py-14 lg:py-20 border-y border-slate-800/70 bg-slate-950/50 scroll-mt-20">
  <div class="max-w-7xl mx-auto space-y-8">
    <div class="text-center max-w-3xl mx-auto space-y-2">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white flex items-center justify-center gap-3"><i data-i="activity" class="w-8 h-8 text-brand-glow shrink-0"></i>Cifras y zonas calientes</h2>
      <p class="text-slate-400 text-sm sm:text-base">Se actualizan al instante con cada reporte que se registra.</p>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-5">
      <div class="glass-card p-5 rounded-2xl"><p class="text-[11px] text-slate-400 font-semibold uppercase tracking-wider">Total denuncias</p><p id="cTotal" class="text-3xl sm:text-4xl font-black text-white tabular-nums mt-1">0</p><p class="text-[11px] text-brand-neon-bright mt-1 flex items-center gap-1"><i data-i="trending-up" class="w-3 h-3"></i><span id="cTodayTxt">0 en las últimas 24 h</span></p></div>
      <div class="glass-card p-5 rounded-2xl"><p class="text-[11px] text-slate-400 font-semibold uppercase tracking-wider">Monto estimado</p><p id="cMoney" class="text-2xl sm:text-4xl font-black text-brand-glow tabular-nums mt-1 break-words">S/ 0</p><p class="text-[11px] text-slate-400 mt-1">Suma de lo exigido en dinero</p></div>
      <div class="glass-card p-5 rounded-2xl"><p class="text-[11px] text-slate-400 font-semibold uppercase tracking-wider">Con evidencia</p><p id="cEv" class="text-3xl sm:text-4xl font-black text-brand-blue-bright tabular-nums mt-1">0%</p><p class="text-[11px] text-slate-400 mt-1">Reportes con foto, video o audio</p></div>
      <div class="glass-card p-5 rounded-2xl"><p class="text-[11px] text-slate-400 font-semibold uppercase tracking-wider">Mayor incidencia este mes</p><p id="cTop" class="text-xl sm:text-2xl font-black text-rose-300 mt-1 truncate">—</p><p id="cTopN" class="text-[11px] text-rose-300 mt-1">—</p></div>
    </div>

    <div class="glass-panel rounded-3xl p-4 sm:p-7 space-y-4">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <h3 class="text-xl font-bold text-white flex items-center gap-2"><i data-i="map-pin" class="w-5 h-5 text-brand-glow"></i>Mapa nocturno del Perú</h3>
          <p class="text-xs text-slate-400">Toca un departamento para ver sus distritos con más reportes. Cubre los 25 departamentos del Perú.</p>
        </div>
        <div class="flex flex-wrap items-center gap-4">
          <div class="seg inline-flex p-1 rounded-2xl bg-slate-950/70 border border-slate-700/60" id="seg" role="group" aria-label="Periodo">
            <button type="button" data-r="day" aria-pressed="false">Hoy</button><button type="button" data-r="week" aria-pressed="true">Esta semana</button><button type="button" data-r="all" aria-pressed="false">Histórico</button>
          </div>
        </div>
      </div>
      <div class="grid lg:grid-cols-[minmax(0,460px)_1fr] gap-6">
        <div class="mapbox relative rounded-2xl border border-blue-700/40 overflow-hidden bg-[#0A0F20] max-w-full" id="mapbox" style="aspect-ratio:5/6;max-height:680px;width:100%">
          <canvas id="map" role="img" aria-label="Mapa nocturno con zonas calientes de reportes"></canvas><div id="tip" class="tip"></div>
        </div>
        <div>
          <div class="flex items-center justify-between gap-2 mb-3"><p class="text-xs font-semibold text-slate-400 uppercase tracking-wider"><span id="rankTitle">Departamentos con más reportes</span></p><button id="rankBack" type="button" hidden class="text-xs text-brand-glow hover:underline inline-flex items-center gap-1"><i data-i="arrow-left" class="w-3.5 h-3.5"></i>Todo el Perú</button></div>
          <ol id="rank" class="space-y-3"></ol>
          <div class="flex flex-wrap gap-x-4 gap-y-1 mt-5 text-[11px] text-slate-400">
            <span><i class="inline-block w-2.5 h-2.5 rounded-full bg-brand-glow mr-1.5"></i>Pocos</span><span><i class="inline-block w-2.5 h-2.5 rounded-full bg-brand-purple mr-1.5"></i>Varios</span><span><i class="inline-block w-2.5 h-2.5 rounded-full bg-rose-500 mr-1.5"></i>Muchos</span>
          </div>
        </div>
      </div>
      <p class="text-xs text-slate-500">Mapa esquemático de todo el Perú (25 departamentos, con sus provincias y distritos en el formulario). Las cifras iniciales son datos de ejemplo para mostrar cómo se verá la plataforma; los reportes que envíes se suman encima.</p>
    </div>
  </div>
</section>

<section id="faq" class="px-4 sm:px-6 lg:px-8 py-14 lg:py-20 max-w-4xl mx-auto space-y-8 scroll-mt-20">
  <div class="text-center space-y-2">
    <h2 class="text-3xl font-extrabold text-white flex items-center justify-center gap-2"><i data-i="shield" class="w-7 h-7 text-brand-purple-bright shrink-0"></i>Preguntas frecuentes y seguridad</h2>
    <p class="text-slate-400 text-sm">Qué pasa con tu información, sin letra chica.</p>
  </div>
  <div class="space-y-3">
    <details class="faq glass-panel rounded-2xl" open>
      <summary class="p-5 flex items-center justify-between gap-4 font-bold text-white"><span class="flex items-center gap-2.5"><i data-i="lock" class="w-4 h-4 text-brand-glow shrink-0"></i>¿Es seguro mi reporte?</span><span class="pm text-2xl leading-none text-brand-purple-bright">+</span></summary>
      <div class="px-5 pb-5 text-sm text-slate-300 leading-relaxed space-y-3">
        <p>La plataforma está diseñada para que no haya a quién identificar: <strong class="text-white">no pide nombre, correo ni teléfono</strong>, la comunicación va cifrada y, con el interruptor de anonimato activo, no se guarda tu IP ni datos de tu dispositivo. Solo queda lo que ocurrió y dónde.</p>
        <p>Si usas el GPS, se convierte en el distrito más cercano; la coordenada exacta no se guarda.</p>
        <p class="p-3 rounded-xl text-[13px] bg-rose-500/10 border border-rose-500/30 text-rose-200">Esta versión es una demostración sin servidor: los reportes se guardan solo en este navegador. Antes de recibir denuncias reales hay que conectar un backend con estas garantías.</p>
      </div>
    </details>
    <details class="faq glass-panel rounded-2xl">
      <summary class="p-5 flex items-center justify-between gap-4 font-bold text-white"><span class="flex items-center gap-2.5"><i data-i="file-text" class="w-4 h-4 text-brand-blue-bright shrink-0"></i>¿Qué pasa con mi denuncia?</span><span class="pm text-2xl leading-none text-brand-purple-bright">+</span></summary>
      <div class="px-5 pb-5 text-sm text-slate-300 leading-relaxed space-y-3">
        <p>Cada reporte se suma a una base de datos consolidada, sin datos personales. Con ella, <strong class="text-white">Vanguardia Ciudadana</strong> genera informes periódicos por distrito, avenida, tipo de intervención y monto exigido.</p>
        <p>Esos informes se envían a Inspectoría, a medios de comunicación y a entidades fiscalizadoras, para que vean patrones y no casos aislados.</p>
      </div>
    </details>
    <details class="faq glass-panel rounded-2xl">
      <summary class="p-5 flex items-center justify-between gap-4 font-bold text-white"><span class="flex items-center gap-2.5"><i data-i="clock" class="w-4 h-4 text-brand-purple-bright shrink-0"></i>¿Puedo editar o borrar mi reporte después?</span><span class="pm text-2xl leading-none text-brand-purple-bright">+</span></summary>
      <div class="px-5 pb-5 text-sm text-slate-300 leading-relaxed space-y-3">
        <p>Como es anónimo, no existe una cuenta que te vincule con el reporte, así que <strong class="text-white">una vez enviado no se puede editar ni borrar</strong>. Eso protege la integridad de los datos: nadie puede alterar ni retirar denuncias ajenas.</p>
        <p>Si te equivocaste en algo importante, envía un nuevo reporte con el dato correcto. En esta demostración puedes borrar lo guardado en tu navegador desde el pie de página.</p>
      </div>
    </details>
  </div>
</section>
</main>

<footer class="border-t border-slate-800/80 bg-slate-950 py-8 px-4 text-center text-xs text-slate-500 space-y-2">
  <p>Breaking the Silence · Plataforma ciudadana independiente</p>
  <p>Desarrollado por <span class="text-slate-300 font-semibold">Vanguardia Ciudadana</span>. Si estás en peligro inmediato, llama al 105 (Policía Nacional).</p>
  <button id="wipe" type="button" class="underline text-slate-400 hover:text-rose-400">Borrar reportes guardados en este dispositivo</button>
</footer>

<!-- Modal de confirmación -->
<div id="modal" class="fixed inset-0 z-[90] bg-black/80 backdrop-blur-md flex items-center justify-center p-4" hidden role="dialog" aria-modal="true" aria-labelledby="mTitle">
  <div class="glass-panel max-w-md w-full rounded-3xl p-7 space-y-5 text-center border-brand-neon/40">
    <svg class="check w-24 h-24 mx-auto drop-shadow-[0_0_14px_rgba(0,255,135,.6)]" viewBox="0 0 100 100" aria-hidden="true"><circle cx="50" cy="50" r="42"/><path d="M32 52l14 14 24-28"/></svg>
    <div class="space-y-1"><h3 id="mTitle" class="text-2xl font-black text-white">¡Reporte registrado!</h3><p class="text-sm text-slate-300">Ya suma al mapa y a las cifras públicas. Gracias por romper el silencio.</p></div>
    <div class="bg-slate-950 p-4 rounded-2xl border border-slate-800">
      <span class="text-[11px] uppercase text-slate-400 tracking-wider font-semibold">Código de seguimiento anónimo</span>
      <p id="mCode" class="font-mono text-xl font-black text-brand-glow tracking-widest mt-1">#BTS-0000-X</p>
      <button id="copyCode" type="button" class="mt-2 text-xs text-slate-400 hover:text-white inline-flex items-center gap-1.5"><i data-i="copy" class="w-3.5 h-3.5"></i>Copiar código</button>
    </div>
    <button id="mClose" type="button" class="btn-neon w-full py-3.5 rounded-xl font-bold">Entendido</button>
  </div>
</div>

<div id="toast" class="toast" role="status" aria-live="polite"><span id="toastIc" class="ic">✓</span><span id="toastMsg"></span></div>

