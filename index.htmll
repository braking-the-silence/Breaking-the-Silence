var CEN={'01':[-6.23,-77.87],'02':[-9.53,-77.53],'03':[-13.64,-72.88],'04':[-16.40,-71.54],'05':[-13.16,-74.22],'06':[-7.16,-78.51],'07':[-12.06,-77.15],
 '08':[-13.53,-71.97],'09':[-12.79,-74.98],'10':[-9.93,-76.24],'11':[-14.07,-75.73],'12':[-12.07,-75.21],'13':[-8.11,-79.03],'14':[-6.77,-79.84],'15':[-11.9,-76.6],
 '16':[-3.75,-73.25],'17':[-12.60,-69.19],'18':[-17.19,-70.93],'19':[-10.68,-76.26],'20':[-5.19,-80.63],'21':[-15.84,-70.02],'22':[-6.03,-76.97],'23':[-18.01,-70.25],'24':[-3.57,-80.45],'25':[-8.38,-74.55]};
var DEP={},PROV={},DIST={},DEPLIST=[];   
PE.forEach(function(d){
  DEP[d[0]]={c:d[0],n:d[1],provs:d[2]};DEPLIST.push(DEP[d[0]]);
  d[2].forEach(function(p){
    PROV[d[0]+p[0]]={c:d[0]+p[0],n:p[1],dists:p[2],dc:d[0]};
    p[2].forEach(function(n,i){var pad2=function(x){return x<10?'0'+x:''+x};DIST[d[0]+p[0]+pad2(i+1)]={n:n,p:p[1],d:d[1],dc:d[0]}});
  });
});

(function(){DIST={};PE.forEach(function(d){d[2].forEach(function(p){p[2].forEach(function(n,i){DIST[d[0]+p[0]+(i<9?'0':'')+(i+1)]={n:n,p:p[1],d:d[1],dc:d[0]}})})})})();
function label(u){var x=DIST[u];return x?x.n+', '+x.p+' · '+x.d:'—'}


var sDep=$('#dep'),sProv=$('#prov'),sDist=$('#district');
function fill(sel,items,ph){sel.innerHTML='<option value="">'+ph+'</option>'+items.map(function(i){return '<option value="'+i[0]+'">'+esc(i[1])+'</option>'}).join('');sel.disabled=!items.length}
function esc(s){return String(s).replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}
fill(sDep,DEPLIST.map(function(d){return[d.c,d.n]}).sort(function(a,b){return a[1].localeCompare(b[1],'es')}),'Selecciona');
function fillProvs(dc){fill(sProv,dc?DEP[dc].provs.map(function(p){return[p[0],p[1]]}).sort(function(a,b){return a[1].localeCompare(b[1],'es')}):[],dc?'Selecciona':'Primero el departamento');fillDists()}
function fillDists(){
  var dc=sDep.value,pc=sProv.value,p=PROV[dc+pc];
  fill(sDist,p?p.dists.map(function(n,i){return[dc+pc+(i<9?'0':'')+(i+1),n]}).sort(function(a,b){return a[1].localeCompare(b[1],'es')}):[],p?'Selecciona':'Primero la provincia');
}
fillProvs('');

var KEY='bts_reports_v3';
function load(){try{var r=JSON.parse(localStorage.getItem(KEY)||'[]');return Array.isArray(r)?r.filter(function(x){return DIST[x.u]}):[]}catch(e){return[]}}
function save(l){try{localStorage.setItem(KEY,JSON.stringify(l));return true}catch(e){return false}}
var mine=load();

function rng(s){return function(){s|=0;s=s+0x6D2B79F5|0;var t=Math.imul(s^s>>>15,1|s);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296}}
var W_DEP={'15':30,'07':8,'13':6,'20':6,'04':6,'14':5,'08':4,'12':4,'11':3,'06':3,'21':3,'02':3,'22':2,'16':2,'25':2,'23':2,'10':2,'05':1.5,'24':1.5};
var seed=(function(){
  var r=rng(20260920),out=[],now=Date.now(),keys=DEPLIST.map(function(d){return d.c}),ws=keys.map(function(k){return W_DEP[k]||1}),sum=ws.reduce(function(a,b){return a+b},0),am=[20,30,50,50,80,100,100,150,200,200,300,500];
  for(var i=0;i<520;i++){
    var p=r()*sum,dc=keys[0];for(var k=0;k<keys.length;k++){p-=ws[k];if(p<=0){dc=keys[k];break}}
    var provs=DEP[dc].provs,pv=(dc==='15'&&r()<.85)?provs[0]:provs[Math.floor(Math.pow(r(),2)*provs.length)];
    var di=Math.floor(Math.pow(r(),(dc==='15'&&pv===provs[0])?1.5:2.2)*pv[2].length),u=dc+pv[0]+(di<9?'0':'')+(di+1);
    var age=Math.pow(r(),1.7)*90*864e5;if(i<14)age=r()*20*36e5;else if(i<60)age=r()*6*864e5;
    out.push({u:u,t:now-age,a:am[Math.floor(r()*am.length)],ev:r()<.38?1:0});
  }
  return out;
})();
function all(){return seed.concat(mine)}

function pad(n){return n<10?'0'+n:''+n}
function money(n){return 'S/ '+Math.round(n).toLocaleString('es-PE')}
var toastT;
function toast(msg,bad){
  var t=$('#toast');$('#toastMsg').textContent=msg;$('#toastIc').textContent=bad?'!':'✓';
  t.classList.toggle('bad',!!bad);t.classList.add('on');clearTimeout(toastT);toastT=setTimeout(function(){t.classList.remove('on')},bad?4200:4800);
}

function panic(){try{sessionStorage.clear()}catch(e){}window.open('','_self');window.close();location.replace('https://www.google.com')}
$('#exitBtn').addEventListener('click',panic);
var lastEsc=0;document.addEventListener('keydown',function(e){
  if(e.key==='Escape'){if(!$('#modal').hidden){closeModal();return}var n=Date.now();if(n-lastEsc<600)panic();lastEsc=n}
});
$('#ctaMain').addEventListener('click',function(e){e.preventDefault();$('#reporte').scrollIntoView({behavior:'smooth',block:'start'});setTimeout(function(){sDep.focus({preventScroll:true})},700)});

function setNow(){var d=new Date();$('#rdate').value=d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate());$('#rtime').value=pad(d.getHours())+':'+pad(d.getMinutes())}
setNow();

var files=[];
function mark(id,ok,show){var f=$(id);f.classList.toggle('bad',!ok&&show);f.classList.toggle('ok',ok&&show)}
function vDistrict(show){var ok=!!sDist.value;mark('#f-district',ok,show);return ok}
function vPlace(show){var ok=$('#place').value.trim().length>=4;mark('#f-place',ok,show);return ok}
function vVeh(show){var ok=!!document.querySelector('input[name=veh]:checked');mark('#f-veh',ok,show);return ok}
function vAmt(show){var ok=$('#amt').value.trim().length>=2;mark('#f-amt',ok,show);return ok}
function whenMs(){var d=$('#rdate').value,t=$('#rtime').value;return d?new Date(d+'T'+(t||'00:00')).getTime():NaN}
function vWhen(show){var ms=whenMs(),ok=!isNaN(ms)&&ms<=Date.now()+60000;$('#whenErr').style.display=(!ok&&show)?'block':'none';['#rdate','#rtime'].forEach(function(s){$(s).style.borderColor=(!ok&&show)?'#F43F5E':''});return ok}
function progress(){var n=[vDistrict(false),vPlace(false),vVeh(false),vAmt(false)].filter(Boolean).length;$('#meter').style.width=(n/4*100)+'%'}
sDep.addEventListener('change',function(){fillProvs(sDep.value);vDistrict(true);progress()});
sProv.addEventListener('change',function(){fillDists();vDistrict(true);progress()});
sDist.addEventListener('change',function(){vDistrict(true);progress()});
$('#place').addEventListener('input',function(){vPlace(true);progress()});
$('#place').addEventListener('blur',function(){if($('#place').value)vPlace(true)});
$('#amt').addEventListener('input',function(){vAmt(true);progress()});
$('#amt').addEventListener('blur',function(){if($('#amt').value)vAmt(true)});
$('#rdate').addEventListener('input',function(){vWhen(true)});$('#rtime').addEventListener('input',function(){vWhen(true)});
[].forEach.call(document.querySelectorAll('input[name=veh]'),function(r){r.addEventListener('change',function(){vVeh(true);progress()})});
$('#presets').addEventListener('click',function(e){var b=e.target.closest('.pill');if(!b)return;$('#amt').value=b.dataset.v;vAmt(true);progress()});

$('#gps').addEventListener('click',function(){
  var b=$('#gps');
  if(!navigator.geolocation){toast('Tu navegador no permite usar el GPS. Elige el lugar a mano.',true);return}
  b.disabled=true;$('#gpsTxt').textContent='Buscando señal GPS…';
  navigator.geolocation.getCurrentPosition(function(p){
    var la=p.coords.latitude,lo=p.coords.longitude,best=null,bd=1e9;
    Object.keys(CEN).forEach(function(k){var x=CEN[k][0]-la,y=CEN[k][1]-lo,q=x*x+y*y;if(q<bd){bd=q;best=k}});
    b.disabled=false;$('#gpsTxt').textContent='Usar mi ubicación GPS actual';
    if(la<-18.6||la>0.3||lo<-81.5||lo>-68.5){toast('Tu ubicación está fuera del Perú. Elige el lugar a mano.',true);return}
    sDep.value=best;fillProvs(best);vDistrict(true);progress();$('#gpsTxt').textContent='Detectado: '+DEP[best].n;sProv.focus();
    toast('Parece que estás en '+DEP[best].n+'. Confirma y elige provincia y distrito.');
  },function(err){
    b.disabled=false;$('#gpsTxt').textContent='Usar mi ubicación GPS actual';
    toast(err&&err.code===1?'Permiso de ubicación denegado. Elige el lugar a mano.':'No pudimos obtener tu ubicación. Elige el lugar a mano.',true);
  },{enableHighAccuracy:true,timeout:9000,maximumAge:30000});
});

function fileErr(m){var e=$('#fileErr');e.hidden=!m;e.textContent=m||''}
function addFiles(list){
  fileErr('');
  [].forEach.call(list,function(f){
    if(files.length>=5){fileErr('Máximo 5 archivos.');return}
    if(!/^(image|video|audio)\//.test(f.type)){fileErr('“'+f.name+'” no es foto, video ni audio.');return}
    if(f.size>25*1048576){fileErr('“'+f.name+'” pesa más de 25 MB.');return}
    files.push(f);
  });render();
}
function render(){
  var ul=$('#files');ul.innerHTML='';
  files.forEach(function(f,i){
    var li=document.createElement('li');li.className='flex items-center gap-3 p-2 rounded-xl bg-slate-950/70 border border-slate-800 text-xs';
    var th=f.type.indexOf('image')===0?'<img class="w-10 h-10 rounded-lg object-cover shrink-0" alt="" src="'+URL.createObjectURL(f)+'">'
      :'<span class="w-10 h-10 rounded-lg bg-slate-800 grid place-items-center shrink-0 text-brand-purple-bright">'+svg(f.type.indexOf('video')===0?'film':'mic','w-5 h-5')+'</span>';
    li.innerHTML=th+'<span class="flex-1 min-w-0 truncate text-slate-200">'+esc(f.name)+'</span><span class="text-slate-500 shrink-0">'+(f.size/1048576).toFixed(1)+' MB</span>'+
      '<button type="button" class="p-1.5 text-slate-400 hover:text-rose-400 rounded-lg" aria-label="Quitar '+esc(f.name)+'">'+svg('x','w-4 h-4')+'</button>';
    li.querySelector('button').addEventListener('click',function(){files.splice(i,1);render()});ul.appendChild(li);
  });
}
var drop=$('#drop');
['dragenter','dragover'].forEach(function(v){drop.addEventListener(v,function(e){e.preventDefault();drop.classList.add('over')})});
['dragleave','drop'].forEach(function(v){drop.addEventListener(v,function(e){e.preventDefault();drop.classList.remove('over')})});
drop.addEventListener('drop',function(e){addFiles(e.dataTransfer.files)});
$('#fileIn').addEventListener('change',function(e){addFiles(e.target.files);e.target.value=''});

$('#anon').addEventListener('change',function(){
  var b=$('#anonBadge');
  if(this.checked){b.className='shrink-0 px-3 py-1.5 rounded-full bg-brand-neon/10 border border-brand-neon/40 text-brand-neon-bright text-xs font-bold inline-flex items-center gap-1.5';b.innerHTML=svg('shield-check','w-3.5 h-3.5')+'<span>Anónimo</span>'}
  else{b.className='shrink-0 px-3 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/40 text-amber-300 text-xs font-bold inline-flex items-center gap-1.5';b.innerHTML=svg('user','w-3.5 h-3.5')+'<span>Identificable</span>';
    toast('Sin anonimato, el reporte podría ligarse a datos técnicos de tu dispositivo. Te recomendamos mantenerlo activo.',true)}
});

function parseAmount(t){
  var m=t.replace(/\s/g,'').match(/(\d{1,3}(?:[.,]\d{3})+|\d+)(?:[.,](\d{1,2}))?/);if(!m)return 0;
  var n=parseFloat(m[1].replace(/[.,]/g,'')+(m[2]?'.'+m[2]:''));if(/\$|usd|d[oó]lar/i.test(t))n*=3.75;
  return isFinite(n)?Math.min(n,1e6):0;
}
var lastFocus=null;
function openModal(code){lastFocus=document.activeElement;$('#mCode').textContent=code;$('#modal').hidden=false;$('#mClose').focus()}
function closeModal(){$('#modal').hidden=true;if(lastFocus&&lastFocus.focus)lastFocus.focus({preventScroll:true})}
$('#mClose').addEventListener('click',closeModal);
$('#modal').addEventListener('click',function(e){if(e.target===$('#modal'))closeModal()});
$('#copyCode').addEventListener('click',function(){
  var c=$('#mCode').textContent;
  try{navigator.clipboard.writeText(c).then(function(){toast('Código copiado.')},function(){toast('No se pudo copiar. Anótalo a mano.',true)})}catch(e){toast('No se pudo copiar. Anótalo a mano.',true)}
});
function busy(on){$('#submitBtn').disabled=on;$('#sSpin').hidden=!on;$('#sIco').hidden=on;$('#sTxt').textContent=on?'Cifrando y enviando…':'Enviar reporte seguro'}
$('#rf').addEventListener('submit',function(e){
  e.preventDefault();
  var checks=[[vDistrict(true),'#f-district'],[vPlace(true),'#f-place'],[vVeh(true),'#f-veh'],[vAmt(true),'#f-amt'],[vWhen(true),'#f-date']],bad=checks.filter(function(c){return!c[0]})[0];
  if(bad){$(bad[1]).scrollIntoView({behavior:'smooth',block:'center'});toast('Falta completar los campos marcados en rojo.',true);return}
  busy(true);
  setTimeout(function(){
  
    mine.push({u:sDist.value,t:whenMs(),a:parseAmount($('#amt').value),v:document.querySelector('input[name=veh]:checked').value,ev:files.length?1:0,anon:$('#anon').checked});
    var ok=save(mine),code='#BTS-'+Math.floor(1000+Math.random()*9000)+'-'+String.fromCharCode(65+Math.floor(Math.random()*26));
    busy(false);$('#rf').reset();fillProvs('');files=[];render();
    ['#f-district','#f-place','#f-veh','#f-amt'].forEach(function(s){$(s).classList.remove('bad','ok')});
    $('#gpsTxt').textContent='Usar mi ubicación GPS actual';$('#anon').dispatchEvent(new Event('change'));
    setNow();progress();refresh();openModal(code);
    toast('¡Reporte registrado exitosamente de forma confidencial!');
    if(!ok)setTimeout(function(){toast('No pudimos guardar en este navegador; se verá solo mientras la página siga abierta.',true)},5200);
  },1300);
});
$('#wipe').addEventListener('click',function(){
  if(!mine.length){toast('No hay reportes guardados en este dispositivo.',true);return}
  mine=[];save(mine);refresh();toast('Reportes de este dispositivo borrados.');
});

var shown={};
function count(id,to,fmt){
  var el=$(id),from=shown[id]||0,t0=performance.now(),dur=900;shown[id]=to;
  if(matchMedia('(prefers-reduced-motion:reduce)').matches){el.textContent=fmt(to);return}
  (function step(t){var p=Math.min(1,(t-t0)/dur),e=1-Math.pow(1-p,3);el.textContent=fmt(from+(to-from)*e);if(p<1)requestAnimationFrame(step)})(t0);
}
var fInt=function(n){return Math.round(n).toLocaleString('es-PE')};
function refresh(){
  var a=all(),n=Date.now(),total=a.length,sum=a.reduce(function(s,r){return s+(r.a||0)},0),today=a.filter(function(r){return n-r.t<=864e5}).length,ev=a.filter(function(r){return r.ev}).length;
  count('#cTotal',total,fInt);count('#heroTotal',total,fInt);count('#cMoney',sum,money);count('#heroMoney',sum,money);count('#heroToday',today,fInt);
  count('#cEv',Math.round(ev/Math.max(1,total)*100),function(v){return Math.round(v)+'%'});
  $('#cTodayTxt').textContent=today+' en las últimas 24 h';
  var c={};a.forEach(function(r){if(n-r.t<=30*864e5)c[r.u]=(c[r.u]||0)+1});
  var top=Object.keys(c).sort(function(x,y){return c[y]-c[x]})[0];  $('#cTop').textContent=top?DIST[top].n:'—';$('#cTopN').textContent=top?DIST[top].p+' · '+DIST[top].d+' · '+c[top]+' reportes en 30 días':'Sin datos este mes';
  drawMap();
}

var range='week',selDep=null,cv=$('#map'),cx=cv.getContext('2d'),W=0,H=0,S=1,OX=0,OY=0,spots=[],phase=0;
var LON0=-81.7,LAT1=0.6,LAT0=-18.7,LON1=-68.3,K=Math.cos(9*Math.PI/180);
function proj(lat,lon){return[OX+(lon-LON0)*K*S,OY+(LAT1-lat)*S]}
function size(){
  var r=cv.getBoundingClientRect(),d=Math.min(2,window.devicePixelRatio||1);W=r.width;H=r.height;cv.width=W*d;cv.height=H*d;cx.setTransform(d,0,0,d,0,0);
  S=Math.min((W-16)/((LON1-LON0)*K),(H-16)/(LAT1-LAT0));OX=(W-(LON1-LON0)*K*S)/2;OY=(H-(LAT1-LAT0)*S)/2;drawMap();
}
function path(flat){cx.beginPath();for(var i=0;i<flat.length;i+=2){var p=proj(flat[i+1],flat[i]);i?cx.lineTo(p[0],p[1]):cx.moveTo(p[0],p[1])}cx.closePath()}
var LC=[[0,255,135],[124,58,237],[255,77,109]],LF=['#00FF87','#B794FF','#FF4D6D'],LB=['#10B981','#7C3AED','#F43F5E'];
var TH={dept:{day:[2,5],week:[5,15],all:[15,50]},dist:{day:[2,3],week:[2,4],all:[4,10]}};
function lvl(v,kind){var t=TH[kind][range];return v<t[0]?0:v<t[1]?1:2}
function counts(){var lim=range==='day'?864e5:range==='week'?7*864e5:Infinity,n=Date.now(),byD={},byU={};
  all().forEach(function(r){if(n-r.t<=lim){var dc=r.u.slice(0,2);byD[dc]=(byD[dc]||0)+1;byU[r.u]=(byU[r.u]||0)+1}});return{d:byD,u:byU}}
function drawMap(){
  if(!W)return;
  var g=cx.createLinearGradient(0,0,W,H);g.addColorStop(0,'#0B1226');g.addColorStop(1,'#120B2A');cx.fillStyle=g;cx.fillRect(0,0,W,H);

  cx.strokeStyle='rgba(120,140,220,.07)';cx.lineWidth=1;cx.beginPath();
  for(var lo=-80;lo<=-68;lo+=4){var a=proj(LAT1,lo),b=proj(LAT0,lo);cx.moveTo(a[0],a[1]);cx.lineTo(b[0],b[1])}
  for(var la=-16;la<=0;la+=4){var c=proj(la,LON0),d=proj(la,LON1);cx.moveTo(c[0],c[1]);cx.lineTo(d[0],d[1])}cx.stroke();

  ['EC','CO','BR','BO','CL'].forEach(function(k){(GEO[k]||[]).forEach(function(f){path(f);cx.fillStyle='rgba(120,140,220,.05)';cx.fill();cx.strokeStyle='rgba(120,140,220,.22)';cx.lineWidth=1;cx.stroke()})});

  (GEO.PE||[]).forEach(function(f){path(f);cx.fillStyle='rgba(37,99,235,.16)';cx.fill();cx.strokeStyle='rgba(96,165,250,.85)';cx.lineWidth=1.6;cx.shadowColor='#2563EB';cx.shadowBlur=14;cx.stroke();cx.shadowBlur=0});
  cx.fillStyle='rgba(120,160,255,.4)';cx.font='600 10px Inter,sans-serif';cx.fillText('OCÉANO PACÍFICO',10,H-12);

  var C=counts(),mx=Math.max.apply(null,Object.keys(C.d).map(function(k){return C.d[k]}).concat([1]));spots=[];
  Object.keys(C.d).forEach(function(k){var n=C.d[k],q=proj(CEN[k][0],CEN[k][1]),kk=n/mx,rad=(Math.min(W,H)/40)*(0.8+Math.sqrt(kk)*2.6);
    spots.push({x:q[0],y:q[1],r:rad,n:n,dc:k,name:DEP[k].n,k:kk,lv:lvl(n,'dept'),col:LC[lvl(n,'dept')]})});
  spots.slice().sort(function(a,b){return a.k-b.k}).forEach(function(s){
    var dim=selDep&&selDep!==s.dc?.35:1,pu=1+Math.sin(phase+s.x)*.07*(s.k+.3),gr=cx.createRadialGradient(s.x,s.y,0,s.x,s.y,s.r*2.1*pu);
    gr.addColorStop(0,'rgba('+s.col+','+(.6*dim)+')');gr.addColorStop(.45,'rgba('+s.col+','+(.22*dim)+')');gr.addColorStop(1,'rgba('+s.col+',0)');
    cx.fillStyle=gr;cx.beginPath();cx.arc(s.x,s.y,s.r*2.1*pu,0,7);cx.fill();
    cx.globalAlpha=dim;cx.beginPath();cx.arc(s.x,s.y,Math.max(3.2,s.r*.2),0,7);cx.fillStyle=LF[s.lv];cx.shadowColor=cx.fillStyle;cx.shadowBlur=12;cx.fill();cx.shadowBlur=0;cx.globalAlpha=1;
    if(selDep===s.dc){cx.beginPath();cx.arc(s.x,s.y,s.r*1.05,0,7);cx.strokeStyle='#fff';cx.lineWidth=1.5;cx.setLineDash([4,4]);cx.stroke();cx.setLineDash([])}
  });
  cx.font='600 10.5px Inter,sans-serif';cx.textAlign='center';
  spots.slice().sort(function(a,b){return b.n-a.n}).slice(0,W<420?5:8).forEach(function(s){cx.fillStyle='rgba(232,238,251,.9)';cx.fillText(s.name,Math.min(W-30,Math.max(30,s.x)),s.y+Math.max(14,s.r*.2+13))});
  cx.textAlign='start';
  if(!spots.length){cx.fillStyle='rgba(154,168,199,.8)';cx.font='500 14px Inter,sans-serif';cx.textAlign='center';cx.fillText('Sin reportes en este periodo',W/2,H/2);cx.textAlign='start'}
  ranking(C,mx);
}
function ranking(C,mx){
  var h='',items;
  if(selDep){
    var byU=C.u,keys=Object.keys(byU).filter(function(u){return u.slice(0,2)===selDep}).sort(function(a,b){return byU[b]-byU[a]}).slice(0,8),m=keys.length?byU[keys[0]]:1;
    $('#rankTitle').textContent='Distritos de '+DEP[selDep].n;$('#rankBack').hidden=false;
    h=keys.length?keys.map(function(u){var v=byU[u],col=LB[lvl(v,'dist')];
      return '<li><div class="flex justify-between text-sm"><span class="text-slate-200 font-medium truncate pr-2">'+esc(DIST[u].n)+'<span class="text-slate-500 text-xs"> · '+esc(DIST[u].p)+'</span></span><span class="text-slate-400 tabular-nums">'+v+'</span></div><div class="h-1.5 rounded bg-slate-800 mt-1.5"><div class="h-full rounded" style="width:'+Math.max(8,v/m*100)+'%;background:'+col+';box-shadow:0 0 10px '+col+'"></div></div></li>'}).join(''):'<li class="text-sm text-slate-500">Sin reportes en este periodo.</li>';
  }else{
    var kd=Object.keys(C.d).sort(function(a,b){return C.d[b]-C.d[a]}).slice(0,8);
    $('#rankTitle').textContent='Departamentos con más reportes';$('#rankBack').hidden=true;
    h=kd.length?kd.map(function(k){var v=C.d[k],col=LB[lvl(v,'dept')];
      return '<li><button type="button" data-dc="'+k+'" class="w-full text-left rounded-lg -mx-1.5 px-1.5 py-1 hover:bg-slate-800/60 transition"><div class="flex justify-between text-sm"><span class="text-slate-200 font-medium truncate pr-2">'+esc(DEP[k].n)+'</span><span class="text-slate-400 tabular-nums">'+v+'</span></div><div class="h-1.5 rounded bg-slate-800 mt-1.5"><div class="h-full rounded" style="width:'+Math.max(8,v/mx*100)+'%;background:'+col+';box-shadow:0 0 10px '+col+'"></div></div></button></li>'}).join(''):'<li class="text-sm text-slate-500">Sin reportes en este periodo.</li>';
  }
  $('#rank').innerHTML=h;
}
function pickDep(k){selDep=(selDep===k)?null:k;drawMap()}
$('#rank').addEventListener('click',function(e){var b=e.target.closest('[data-dc]');if(b)pickDep(b.dataset.dc)});
$('#rankBack').addEventListener('click',function(){selDep=null;drawMap()});
if(!matchMedia('(prefers-reduced-motion:reduce)').matches){(function loop(){phase+=.035;if(W&&document.visibilityState==='visible')drawMap();setTimeout(function(){requestAnimationFrame(loop)},80)})()}
var tip=$('#tip');
function hit(e){var r=cv.getBoundingClientRect(),x=e.clientX-r.left,y=e.clientY-r.top,h=null;spots.forEach(function(s){var dx=s.x-x,dy=s.y-y;if(dx*dx+dy*dy<Math.pow(Math.max(16,s.r),2))h=s});return h}
cv.addEventListener('mousemove',function(e){var h=hit(e);if(h){tip.innerHTML='<b style="color:#00FF87">'+esc(h.name)+'</b> · '+h.n+' reporte'+(h.n===1?'':'s');tip.style.left=Math.min(W-70,Math.max(70,h.x))+'px';tip.style.top=h.y+'px';tip.classList.add('on');cv.style.cursor='pointer'}else{tip.classList.remove('on');cv.style.cursor='default'}});
cv.addEventListener('mouseleave',function(){tip.classList.remove('on')});
cv.addEventListener('click',function(e){var h=hit(e);if(h)pickDep(h.dc)});
$('#seg').addEventListener('click',function(e){var b=e.target.closest('button');if(!b)return;range=b.dataset.r;[].forEach.call($('#seg').children,function(x){x.setAttribute('aria-pressed',x===b)});drawMap()});
window.addEventListener('resize',size);if(window.ResizeObserver)new ResizeObserver(size).observe($('#mapbox'));
size();refresh();progress();
})();
</script>
</body>
</html>
